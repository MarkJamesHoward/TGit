# TGit Dashboard Configuration

# URL of the TGit API
PUBLIC_API_BASE_URL=https://your-api.azurewebsites.net

# Azure Cosmos DB (for passkey auth & tenant persistence)
COSMOS_ENDPOINT=https://tgit.documents.azure.com:443/
COSMOS_KEY=PLACEHERE
COSMOS_DATABASE=tgit

# WebAuthn / Passkey configuration
WEBAUTHN_RP_NAME=tgit.documents.azure.com
WEBAUTHN_RP_ID=https:///tgit.app
WEBAUTHN_ORIGIN=http://localhost:4321
