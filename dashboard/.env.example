# TGit Dashboard Configuration

# URL of the TGit API
PUBLIC_TGIT_DASHBOARD_API_URL=https://tgit-api.azurewebsites.net

# Azure SQL Database (for passkey auth & tenant persistence)
SQL_CONNECTION_STRING=Server=hvhsejcxpv.database.windows.net;Database=tgit-database;Authentication=Active Directory Default;Encrypt=true;TrustServerCertificate=false;

# WebAuthn / Passkey configuration
WEBAUTHN_RP_NAME=TGit
WEBAUTHN_RP_ID=tgit.app
WEBAUTHN_ORIGIN=http://localhost:4321
