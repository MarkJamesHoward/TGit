---
interface Props {
  title: string;
  user?: { displayName: string } | null;
}

const { title, user } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="TGit - Git Activity Dashboard" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="user-bar">
      {user ? (
        <>
          <span class="user-bar-name">{user.displayName}</span>
          <button id="logout-btn" class="user-bar-logout">Sign out</button>
        </>
      ) : (
        <a href="/login" class="user-bar-signin">Sign in</a>
      )}
    </div>
    <slot />
    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/';
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-primary: #0d1117;
    --bg-secondary: #161b22;
    --bg-tertiary: #21262d;
    --border-color: #30363d;
    --text-primary: #e6edf3;
    --text-secondary: #8b949e;
    --accent-green: #3fb950;
    --accent-yellow: #d29922;
    --accent-red: #f85149;
    --accent-blue: #58a6ff;
    --accent-purple: #a371f7;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.5;
    min-height: 100vh;
  }

  a {
    color: var(--accent-blue);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .user-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    padding: 8px 24px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }

  .user-bar-name {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .user-bar-logout {
    font-size: 13px;
    color: var(--text-secondary);
    background: none;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 4px 12px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .user-bar-logout:hover {
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  .user-bar-signin {
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .user-bar-signin:hover {
    color: var(--text-primary);
    text-decoration: none;
  }
</style>
