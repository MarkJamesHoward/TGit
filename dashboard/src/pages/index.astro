---
import Layout from '../layouts/Layout.astro';

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL || 'https://api.tgit.app';
const user = Astro.locals.user;

// If no tenant param and user has a lastTenant, redirect
const tenantParam = Astro.url.searchParams.get('tenant');
if (!tenantParam && user?.lastTenant) {
  return Astro.redirect(`/?tenant=${encodeURIComponent(user.lastTenant)}`);
}
---

<Layout title="TGit Dashboard" user={user}>
  <div class="container">
    <div class="filters">
      <div class="tenant-input-group">
        <label for="tenant-input" class="tenant-label">Set your tenant to view activity</label>
        <div class="tenant-input-row">
          <input
            type="text"
            id="tenant-input"
            placeholder="Enter tenant ID..."
            class="search-input tenant-input"
          />
          <button id="tenant-btn" class="tenant-btn" title="Load Tenant">Go</button>
        </div>
      </div>
    </div>

    <div class="users-grid" id="users-grid">
      <div class="empty-state" id="loading-state">
        <p>Loading...</p>
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ apiBaseUrl }}>
  window.__API_BASE_URL__ = apiBaseUrl;
</script>

<script>
  const API_BASE_URL = (window as any).__API_BASE_URL__ || '';

  function getTimeSince(timestamp: string): string {
    const now = Date.now();
    const activityTime = new Date(timestamp).getTime();
    const diffMs = now - activityTime;
    const minutes = Math.floor(diffMs / 60000);
    const hours = Math.floor(diffMs / 3600000);
    const days = Math.floor(diffMs / 86400000);
    if (minutes < 1) return "just now";
    if (minutes < 60) return `${minutes}m ago`;
    if (hours < 24) return `${hours}h ago`;
    return `${days}d ago`;
  }

  function getStatusColor(status: string): string {
    switch (status) {
      case 'Added': return 'var(--accent-green)';
      case 'Modified': return 'var(--accent-yellow)';
      case 'Deleted': return 'var(--accent-red)';
      case 'Renamed': return 'var(--accent-purple)';
      default: return 'var(--text-secondary)';
    }
  }

  function getStatusIcon(status: string): string {
    switch (status) {
      case 'Added': return '+';
      case 'Modified': return '~';
      case 'Deleted': return '-';
      case 'Renamed': return '→';
      case 'Untracked': return '?';
      default: return '•';
    }
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function renderMachineCard(machineCard: any): string {
    // Render repositories directly - no machine grouping needed
    // Filter out repos with no modified files
    const reposHtml = machineCard.activities
      .filter((activity: any) => activity.modifiedFiles && activity.modifiedFiles.length > 0)
      .map((activity: any) => {
      const filesHtml = activity.modifiedFiles.slice(0, 5).map((file: any) => `
        <div class="file">
          <span class="file-status" style="color: ${getStatusColor(file.status)}">${getStatusIcon(file.status)}</span>
          <span class="file-path">${escapeHtml(file.filePath)}</span>
          ${file.isStaged ? '<span class="staged-badge">staged</span>' : ''}
        </div>
      `).join('');

      const moreFiles = activity.modifiedFiles.length > 5
        ? `<div class="more-files">+${activity.modifiedFiles.length - 5} more files</div>`
        : '';

      return `
        <div class="repo">
          <div class="repo-header">
            <span class="repo-name">${escapeHtml(activity.repoName)}</span>
            <span class="branch">
              <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
                <path fill-rule="evenodd" d="M11.75 2.5a.75.75 0 100 1.5.75.75 0 000-1.5zm-2.25.75a2.25 2.25 0 113 2.122V6A2.5 2.5 0 0110 8.5H6a1 1 0 00-1 1v1.128a2.251 2.251 0 11-1.5 0V5.372a2.25 2.25 0 111.5 0v1.836A2.492 2.492 0 016 7h4a1 1 0 001-1v-.628A2.25 2.25 0 019.5 3.25zM4.25 12a.75.75 0 100 1.5.75.75 0 000-1.5zM3.5 3.25a.75.75 0 111.5 0 .75.75 0 01-1.5 0z"></path>
              </svg>
              ${escapeHtml(activity.branch)}
            </span>
          </div>
          <div class="files">${filesHtml}${moreFiles}</div>
        </div>
      `;
    }).join('');

    return `
      <div class="machine-card" data-active="${machineCard.isActive}">
        <span class="status-badge ${machineCard.isActive ? 'active' : 'idle'}">${machineCard.isActive ? 'Active' : 'Idle'}</span>

        <div class="machine-header">
          <div class="machine-name">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
            ${escapeHtml(machineCard.machineName)}
          </div>
          <div class="user-info">
            <span class="user-name">${escapeHtml(machineCard.userName)}</span>
            <span class="last-activity"><span class="field-label">Last activity:</span> ${getTimeSince(machineCard.lastActivity)}</span>
          </div>
        </div>
        <div class="repos">${reposHtml}</div>
      </div>
    `;
  }

  async function loadUsers() {
    const grid = document.getElementById('users-grid')!;
    const params = new URLSearchParams(window.location.search);
    const tenant = params.get('tenant') || 'default';

    try {
      const url = `${API_BASE_URL}/api/users?tenant=${encodeURIComponent(tenant)}`;
      const response = await fetch(url);

      if (!response.ok) {
        throw new Error(`API returned ${response.status}`);
      }

      const data = await response.json();
      const users = data.users || [];

      // Transform users into machine cards (one card per user-machine combination)
      const machineCards: any[] = [];
      users.forEach(user => {
        // Group this user's activities by machine
        const machineGroups: Record<string, any[]> = {};
        user.activities.forEach((activity: any) => {
          const machine = activity.machineName || 'Unknown';
          if (!machineGroups[machine]) machineGroups[machine] = [];
          machineGroups[machine].push(activity);
        });

        // Create a card for each user-machine combination
        Object.entries(machineGroups).forEach(([machine, activities]) => {
          machineCards.push({
            machineName: machine,
            userName: user.userName,
            userEmail: user.userEmail,
            isActive: user.isActive,
            lastActivity: user.lastActivity,
            activities: activities
          });
        });
      });

      if (machineCards.length === 0) {
        grid.innerHTML = `
          <div class="empty-state">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <h2>No Activity Yet</h2>
            <p>When developers use TGit, their machines will appear here.</p>
          </div>
        `;
      } else {
        grid.innerHTML = machineCards.map(renderMachineCard).join('');
        // Adjust card widths based on count
        const cards = grid.querySelectorAll('.machine-card') as NodeListOf<HTMLElement>;
        const count = cards.length;
        let cardWidth = '400px';
        if (count === 1) cardWidth = '600px';
        else if (count === 2) cardWidth = '480px';
        else if (count <= 4) cardWidth = '420px';
        else if (count <= 6) cardWidth = '380px';
        else cardWidth = '350px';
        cards.forEach(c => c.style.width = cardWidth);

        // Focus first card if tenant was selected
        const params = new URLSearchParams(window.location.search);
        const tenant = params.get('tenant');
        if (tenant && tenant !== 'default' && cards.length > 0) {
          cards[0].tabIndex = 0;
          cards[0].focus();
        }
      }
    } catch (error) {
      console.error('Error fetching users:', error);
      grid.innerHTML = `
        <div class="empty-state config-warning">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          <h2>Could not connect to API</h2>
          <p>Make sure the TGit API is running and accessible.</p>
          <code>${API_BASE_URL || '(no API URL configured)'}</code>
        </div>
      `;
    }
  }

  // Tenant navigation
  const tenantInput = document.getElementById('tenant-input') as HTMLInputElement;
  const tenantBtn = document.getElementById('tenant-btn');
  const urlTenant = new URLSearchParams(window.location.search).get('tenant');
  if (tenantInput && urlTenant && urlTenant !== 'default') {
    tenantInput.value = urlTenant;
  }

  // Auto-focus on tenant input when page loads (only if no tenant selected)
  if (!urlTenant || urlTenant === 'default') {
    tenantInput?.focus();
  }

  function goToTenant() {
    const tenant = tenantInput?.value.trim().toLowerCase() || 'default';
    // Save tenant preference server-side
    fetch('/api/tenant/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tenant }),
    }).catch(() => {}); // fire-and-forget
    window.location.href = `/?tenant=${encodeURIComponent(tenant)}`;
  }

  tenantBtn?.addEventListener('click', goToTenant);
  tenantInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') goToTenant();
  });

  // Auto-refresh every 2 seconds
  let refreshInterval = setInterval(() => loadUsers(), 2000);

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      clearInterval(refreshInterval);
    } else {
      loadUsers();
      refreshInterval = setInterval(() => loadUsers(), 2000);
    }
  });

  // Initial load
  loadUsers();
</script>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .filters {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .tenant-input-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .tenant-label {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .tenant-input-row {
    display: flex;
    gap: 4px;
  }

  .tenant-input {
    min-width: 150px;
    flex: 0 1 auto;
    border-radius: 8px 0 0 8px;
  }

  .tenant-btn {
    padding: 10px 16px;
    background: var(--accent-purple, #8b5cf6);
    border: 1px solid var(--accent-purple, #8b5cf6);
    border-radius: 0 8px 8px 0;
    color: white;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .tenant-btn:hover {
    background: #7c3aed;
    border-color: #7c3aed;
  }

  .search-input {
    flex: 1;
    min-width: 150px;
    padding: 10px 14px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 14px;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent-blue);
  }

  .search-input::placeholder {
    color: var(--text-secondary);
  }

  .users-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    flex: 1;
    align-content: flex-start;
    padding-top: 10vh;
  }

  .empty-state {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
    text-align: center;
    color: var(--text-secondary);
  }

  .empty-state svg {
    margin-bottom: 24px;
    opacity: 0.5;
  }

  .empty-state h2 {
    font-size: 20px;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .empty-state p {
    margin-bottom: 16px;
  }

  .empty-state code {
    background: var(--bg-secondary);
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 14px;
    display: block;
    margin-top: 8px;
  }

  .config-warning svg {
    color: var(--accent-yellow);
    opacity: 1;
  }

  .config-warning h2 {
    color: var(--accent-yellow);
  }
</style>

<style is:global>
  .machine-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 16px;
    transition: border-color 0.2s;
    width: 400px;
    min-width: 300px;
    flex-shrink: 1;
    position: relative;
  }

  .machine-card > .status-badge {
    position: absolute;
    top: 12px;
    right: 12px;
  }

  .machine-card:hover {
    border-color: var(--accent-blue);
  }

  .machine-card[data-active="true"] {
    border-left: 3px solid var(--accent-green);
  }

  .machine-card[data-active="false"] {
    border-left: 3px solid var(--text-secondary);
    opacity: 0.7;
  }

  .machine-header {
    margin-bottom: 12px;
  }

  .machine-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--accent-purple);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .machine-name svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .user-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: 28px;
  }

  .user-info .user-name {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .status-badge {
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 12px;
    text-transform: uppercase;
  }

  .status-badge.active {
    background: rgba(63, 185, 80, 0.2);
    color: var(--accent-green);
  }

  .status-badge.idle {
    background: rgba(139, 148, 158, 0.2);
    color: var(--text-secondary);
  }

  .user-email {
    color: var(--text-secondary);
    font-size: 13px;
  }

  .last-activity {
    color: var(--text-secondary);
    font-size: 12px;
    margin-top: 2px;
  }

  .stats {
    display: flex;
    gap: 16px;
    text-align: center;
  }

  .stat-value {
    display: block;
    font-size: 18px;
    font-weight: 600;
    color: var(--accent-blue);
  }

  .stat-label {
    font-size: 11px;
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .repos {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .repo {
    background: var(--bg-tertiary);
    border-radius: 6px;
    padding: 10px 12px;
  }

  .repo-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .repo-name {
    font-weight: 600;
    color: var(--accent-blue);
  }

  .branch {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--text-secondary);
    font-size: 13px;
  }

  .files {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .file {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  }

  .file-status {
    font-weight: 700;
    width: 12px;
    text-align: center;
  }

  .file-path {
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .staged-badge {
    font-size: 10px;
    padding: 1px 5px;
    background: rgba(88, 166, 255, 0.2);
    color: var(--accent-blue);
    border-radius: 4px;
    font-family: inherit;
  }

  .more-files {
    color: var(--text-secondary);
    font-size: 12px;
    padding-left: 20px;
  }

  .field-label {
    color: var(--text-secondary);
    font-weight: 500;
  }
</style>
